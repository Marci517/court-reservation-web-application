<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head.ejs') %>

    <body>
        <header>
            <h1>
                Részletek
            </h1>
        </header>

        <% if (bej !=='Vendeg' ) { %>
            <span>Bejelentkezve mint: <%= bej %> </span>
            <% } %>
                <%- include('../partials/logButtons.ejs') %>
                    <span>Palyatípus: <%= result[0].Nev %>, </span><br>
                    <span>Órabér: <%= result[0].Oraber %>, </span><br>
                    <span>Cím: <%= result[0].Cim %>, </span><br>
                    <span>Leírás: <%= result[0].Leiras %>, </span><br>
                    <span>Nyitvatartás: <%= result[0].NyitKezd %>-<%= result[0].NyitVeg %></span><br>
                    <% const pid=result[0].PID; %>

                        <% result.forEach(resul=> { %>
                            <% if (resul.FNev!==null) { %>
                                <div>
                                    <img src="<%= resul.FNev %>" alt="Nem elérhető">
                                    <% if (bej==='admin' ) { %>
                                        <button class="torlesgombok" data-FNev="<%= resul.FNev %>">Törlés</button>
                                        <% } %>
                                </div>
                                <% } %>
                                    <% }); %>
                                        <script src="deleteImg.js"></script>

                                        <% if (err===1) { %>
                                            <p>
                                                <%= errmess %>
                                            </p>
                                            <% } %>

                                                <% if (bej==='admin' ) { %>
                                                    <form action="/foglalasszures" method="GET">
                                                        <label for="f4datumsz">Szűrj dátum szerint: </label>
                                                        <input type="date" name="f4datumsz" id="f4datumsz" required>
                                                        <input type="hidden" name="f4palyaidsz" id="f4palyaidsz"
                                                            value="<%= pid %>">
                                                        <button type="submit">Submit</button>
                                                    </form>

                                                    <form action="/foglalasosszes" method="GET">
                                                        <input type="hidden" name="f4palyaido" id="f4palyaido"
                                                            value="<%= pid %>">
                                                        <button type="submit">Összes foglalás</button>
                                                    </form>
                                                    <% } %>

                                                        <% if (bej !=='Vendeg' ) { %>
                                                            <form action="/foglalas" method="POST">
                                                                <label for="f4datum">Add meg a dátumot: </label>
                                                                <input type="date" name="f4datum" id="f4datum" required>
                                                                <label for="f4kezd">Add meg a kezdési időt: </label>
                                                                <input type="time" name="f4kezd" id="f4kezd" required>
                                                                <label for="f4vegez">Add meg a végzési időt: </label>
                                                                <input type="time" name="f4vegez" id="f4vegez" required>
                                                                <input type="hidden" name="f4palyaid" id="f4palyaid"
                                                                    value="<%= pid %>">
                                                                <button type="submit">Submit</button>
                                                            </form>

                                                            <% if (err===2) { %>
                                                                <p>
                                                                    <%= errmess %>
                                                                </p>
                                                                <% } %>

                                                                    <% if (err===10) { %>
                                                                        <p>Sikeres foglalás!</p>
                                                                        <% } %>
                                                                            <% if (fog !==1) { %>
                                                                                <% foglalasok.forEach(foglalas=> { %>
                                                                                    <span>Dátum: <%= foglalas.Datum %>,
                                                                                    </span><br>
                                                                                    <span>Kezdés időpont: <%=
                                                                                            foglalas.Kezdes %>
                                                                                            , </span><br>
                                                                                    <span>Vége: <%= foglalas.Vegzes %>
                                                                                    </span><br>
                                                                                    <% if (foglalas.FID===userid ||
                                                                                        bej==='admin' ) { %>
                                                                                        <form action="/torlesfog"
                                                                                            method="POST">
                                                                                            <input type="hidden"
                                                                                                name="FogID" id="FogID"
                                                                                                value="<%= foglalas.FogID %>">
                                                                                            <button
                                                                                                type="submit">Foglalás
                                                                                                Törlése</button>
                                                                                        </form>
                                                                                        <% } %>
                                                                                            <% }); %>
                                                                                                <% } else { %>
                                                                                                    <span>Nincs
                                                                                                        foglalás</span>
                                                                                                    <% } %>
                                                                                                        <% } %>


                                                                                                            <% if
                                                                                                                (bej==='admin'
                                                                                                                ) { %>
                                                                                                                <form
                                                                                                                    action="/kepfeltolt"
                                                                                                                    method="POST"
                                                                                                                    enctype="multipart/form-data">
                                                                                                                    <input
                                                                                                                        type="hidden"
                                                                                                                        name="f1palyaid"
                                                                                                                        id="f1palyaid"
                                                                                                                        value="<%= pid %>">
                                                                                                                    <label
                                                                                                                        for="f1kep">Tölts
                                                                                                                        fel
                                                                                                                        egy
                                                                                                                        képet:
                                                                                                                    </label>
                                                                                                                    <input
                                                                                                                        type="file"
                                                                                                                        name="f1kep"
                                                                                                                        id="f1kep"
                                                                                                                        required>
                                                                                                                    <button
                                                                                                                        type="submit">Submit</button>
                                                                                                                </form>
                                                                                                                <% } %>
                                                                                                                    <form
                                                                                                                        action="/"
                                                                                                                        method="GET">
                                                                                                                        <button
                                                                                                                            type="submit">Vissza
                                                                                                                            a
                                                                                                                            főoldalra</button>
                                                                                                                    </form>

                                                                                                                    <%- include('../partials/footer.ejs')
                                                                                                                        %>

    </body>

</html>