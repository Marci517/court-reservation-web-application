<!DOCTYPE html>
<html lang="en">

<%- include('partials/head.ejs') %>

    <body>
        <header>
            <h1>
                Engedélykérések
            </h1>
        </header>

        
            <span>Bejelentkezve mint: <%= bej %> </span>
                <% result.forEach(resul=> { %>
                    <% if (resul.FelNev!=='admin' && resul.FelNev!=='Vendeg' ) { %>
                        <div>
                            <p>
                                <%= resul.FelNev %>
                            </p>
                            <form action="/engedfel" method="POST">
                                <input type="hidden" name="FID" id="FID" value="<%= resul.FID %>">
                                <button type="submit">Felhasználó elfogadása</button>
                            </form>

                        </div>
                        <% } %>
                            <% }); %>

                                <form action="/" method="GET">
                                    <button type="submit">Vissza
                                        a
                                        főoldalra</button>
                                </form>
                                <% if (err===1) { %>
                                    <p>
                                        <%= errmess %>
                                    </p>
                                    <% } %>
                                <%- include('partials/footer.ejs') %>

    </body>

</html>