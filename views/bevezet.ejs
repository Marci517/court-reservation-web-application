<!DOCTYPE html>
<html lang="en">

<%- include('partials/head.ejs') %>

    <body>
        <header>
            <h1>
                Palyabevezetes
            </h1>
        </header>
        <span>Bejelentkezve mint: <%= bej %>, </span>
        <%- include('partials/logButtons.ejs') %>
            <form action="/palyabevezet" method="POST">
                <label for="palyak">Valassz egy palyat: </label>
                <select name="palyak" id="palyak" required>
                    <option value="kosar">Kosar</option>
                    <option value="foci">Foci</option>
                    <option value="tenisz">Tenisz</option>
                    <option value="futas">Futas</option>
                </select>
                <label for="f0oraber">Add meg az orabert: </label>
                <input type="number" name="f0oraber" id="f0oraber" min="0" max="100000" required>
                <label for="f0cim">Add meg a cimet: </label>
                <input type="text" name="f0cim" id="f0cim" required>
                <label for="f0leiras">Add meg a leirast: </label>
                <input type="text" name="f0leiras" id="f0leiras" required>
                <label for="f0kezd">Nyitas: </label>
                <input type="time" name="f0kezd" id="f0kezd" required>
                <label for="f0vegez">Zaras: </label>
                <input type="time" name="f0vegez" id="f0vegez" required>
                <button type="submit">Submit</button>
            </form>

            <% if (err===1) { %>
                <p>
                    <%= errmess %>
                </p>
                <% } %>
                    <%- include('partials/footer.ejs') %>

    </body>

</html>