<!DOCTYPE html>
<html lang="en">

<%- include('partials/head.ejs') %>

    <body>
        <header>
            <h1>
                Pályabevezetés
            </h1>
        </header>
        <span>Bejelentkezve mint: <%= bej %> </span>
        <%- include('partials/logButtons.ejs') %>
            <form action="/palyabevezet" method="POST">
                <label for="palyak">Válassz egy pályát: </label>
                <select name="palyak" id="palyak" required>
                    <option value="kosar">Kosár</option>
                    <option value="foci">Foci</option>
                    <option value="tenisz">Tenisz</option>
                    <option value="futas">Futás</option>
                </select>
                <label for="f0oraber">Add meg az órabért: </label>
                <input type="number" name="f0oraber" id="f0oraber" min="0" max="100000" required>
                <label for="f0cim">Add meg a címet: </label>
                <input type="text" name="f0cim" id="f0cim" required>
                <label for="f0leiras">Add meg a leírást: </label>
                <input type="text" name="f0leiras" id="f0leiras" required>
                <label for="f0kezd">Nyitás: </label>
                <input type="time" name="f0kezd" id="f0kezd" required>
                <label for="f0vegez">Zárás: </label>
                <input type="time" name="f0vegez" id="f0vegez" required>
                <button type="submit">Submit</button>
            </form>

            <% if (err===1) { %>
                <p>
                    <%= errmess %>
                </p>
                <% } %>
                    <form action="/" method="GET">
                        <button type="submit">Vissza a főoldalra</button>
                    </form>
                    <%- include('partials/footer.ejs') %>

    </body>

</html>