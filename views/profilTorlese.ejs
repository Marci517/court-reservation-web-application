<!DOCTYPE html>
<html lang="en">

<%- include('partials/head.ejs') %>

    <body>
        <header>
            <h1>
                Profil törlése
            </h1>
        </header>
        <% if (bej !=='Vendeg' ) { %>
            <span>Bejelentkezve mint: <%= bej %> </span>
            <% } %>
        <form action="/profiltorlesform" method="POST">
            <label for="f10kod">Add meg a kódot: </label>
            <input type="password" name="f10kod" id="f10kod" required>
            <button type="submit">Submit</button>
        </form>

        <% if (err===1) { %>
            <p>
                <%= errmess %>
            </p>
            <% } %>
                <form action="/" method="GET">
                    <button type="submit">Vissza a főoldalra</button>
                </form>
                <%- include('partials/footer.ejs') %>

    </body>

</html>