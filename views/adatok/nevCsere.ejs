<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head.ejs') %>

    <body>
        <header>
            <h1>
                Név csere
            </h1>
        </header>
        <% if (bej !=='Vendeg' ) { %>
            <span>Bejelentkezve mint: <%= bej %>, </span>
            <% } %>
                <form action="/nevcsereform" method="POST">
                    <label for="f8nev">Add meg az új nevet: </label>
                    <input type="text" name="f8nev" id="f8nev" required>
                    <label for="f8kod">Add meg a kódot: </label>
                    <input type="password" name="f8kod" id="f8kod" required>
                    <button type="submit">Submit</button>
                </form>

                <% if (err===1) { %>
                    <p>
                        <%= errmess %>
                    </p>
                    <% } %>
                        <form action="/" method="GET">
                            <button type="submit">Vissza a főoldalra</button>
                        </form>
                        <%- include('../partials/footer.ejs') %>

    </body>

</html>