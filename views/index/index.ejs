<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head.ejs') %>

    <body>
        <header>
            <h1>
                Pályák
            </h1>
        </header>
        <% if (bej !=='Vendeg' ) { %>
            <span>Bejelentkezve mint: <%= bej %> </span>
            <% } %>
                <% if (bej !=='Vendeg' ) { %>
                    <form action="/adatok" method="GET">
                        <button type="submit">Személyes adatok</button>
                    </form>
                    <% } %>

                        <% if (bej==='admin' ) { %>
                            <form action="/bevezet" method="GET">
                                <button type="submit">Pálya hozzáadás</button>
                            </form>
                            <form action="/felhasznalok" method="GET">
                                <button type="submit">Felhasználók</button>
                            </form>
                            <% } %>
                                <%- include('../partials/logButtons.ejs') %>
                                    <form action="/" method="GET">
                                        <label for="palyakkliens">Válassz egy pályát: </label>
                                        <select name="palyakkliens" id="palyakkliens" required>
                                            <option value="osszes">Összes</option>
                                            <option value="kosar">Kosár</option>
                                            <option value="foci">Foci</option>
                                            <option value="tenisz">Tenisz</option>
                                            <option value="futas">Futás</option>
                                        </select>

                                        <label for="f3orabermin">Add meg a minimum órabért: </label>
                                        <input type="number" name="f3orabermin" id="f3orabermin" min="0">

                                        <label for="f3orabermax">Add meg a maximum órabért: </label>
                                        <input type="number" name="f3orabermax" id="f3orabermax" min="0" max="100000">
                                        <button type="submit">Submit</button>

                                    </form>
                                    <% if (err===0) { %>
                                        <ul id="palyak_lista">
                                            <% resul.forEach(result=> { %>
                                                <li class="informaciok" data-PID="<%= result.PID %>">
                                                    <span>Pályatípus: <%= result.Nev %>,</span>
                                                    <span> Órabér: <%= result.Oraber %>,</span>
                                                    <span> Cím: <%= result.Cim %>, </span>
                                                    <span class="hidden">Leírás: <%= result.Leiras %>, </span>
                                                    <span class="hidden">Nyitvatartás: <%= result.NyitKezd %>-<%=
                                                                result.NyitVeg %></span>
                                                    <a href="/reszletek?id=<%= result.PID %>">Részletek</a>
                                                </li>
                                                <% }); %>
                                        </ul>
                                        <script src="extendInfo.js"></script>
                                        <% } %>

                                            <% if (err===1) { %>
                                                <p>
                                                    <%= errmess %>
                                                </p>
                                                <% } %>



                                                    <%- include('../partials/footer.ejs') %>
    </body>

</html>